{
  "name": "photo-all-is-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --filter @photoallisai/desktop dev",
    "build": "pnpm --filter @photoallisai/desktop build",
    "preview": "pnpm --filter @photoallisai/desktop preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:real-data": "PHOTOALLISAI_TEST_DATA=./test_data vitest run apps/desktop/src/main/catalog-real-data.test.ts --reporter=verbose",
    "test:real-data:preview": "pnpm build && PHOTOALLISAI_TEST_DATA=./test_data playwright test tests/e2e/real-data-preview.spec.ts --reporter=line",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test"
    ,"package:dir": "pnpm build && electron-builder --projectDir apps/desktop --config electron-builder.yml --dir"
    ,"package:mac": "pnpm build && electron-builder --projectDir apps/desktop --config electron-builder.yml --mac"
    ,"package:win": "pnpm build && electron-builder --projectDir apps/desktop --config electron-builder.yml --win"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
